{
  "name": "myhouse-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/warranty.test.ts tests/rbac.test.ts tests/auth.test.ts tests/integration.test.ts tests/security.test.ts tests/tenant.test.ts tests/payments.test.ts tests/queue.test.ts tests/validation.test.ts tests/intelligence.test.ts tests/taxonomy.test.ts",
    "test:coverage": "c8 --reporter=text --reporter=lcov npm test",
    "lint": "eslint src tests scripts",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "smoke": "node --import tsx scripts/smoke.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.1.1",
    "@types/supertest": "^6.0.2",
    "c8": "^11.0.0",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.63.0"
  }
}

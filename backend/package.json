{
  "name": "myhouse-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/warranty.test.ts tests/rbac.test.ts tests/auth.test.ts tests/integration.test.ts",
    "smoke": "node --import tsx scripts/smoke.ts"

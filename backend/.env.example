# ---- MyHouse backend configuration ----
# Copy to .env for local dev. Production values come from the secret manager;
# config.ts validates these at startup and FAILS FAST if production is misconfigured.

NODE_ENV=development            # development | test | staging | production
PORT=4000
DATA_DIR=data                   # JSON store dir (→ PostgreSQL DSN in prod)
LOG_LEVEL=info                  # trace | debug | info | warn | error | fatal

# --- security (REQUIRED in production) ---
JWT_SECRET=dev-only-secret-change-me   # must be >=32 chars in production
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000     # comma-separated whitelist
BODY_LIMIT=1mb

# --- abuse protection ---
RATE_LIMIT=300                  # requests/min per IP and per user
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_WINDOW_SEC=900
LOCKOUT_DURATION_SEC=900

# --- infrastructure (empty = in-memory dev fallbacks) ---
REDIS_URL=                      # e.g. redis://localhost:6379

# --- AI pipeline ---
AI_PROVIDER=mock                # mock | openai | anthropic | gemini (mock banned in prod)
AI_FALLBACK_PROVIDER=mock
AI_TIMEOUT_MS=10000
AI_RETRIES=2
AI_MIN_CONFIDENCE=0.3

# --- event queue ---
EVENT_BACKOFF_MS=50
EVENT_MAX_ATTEMPTS=5

# --- provider API keys (never commit real values) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# STRIPE_SECRET_KEY=
